<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fasha Kharisma Putri | Portfolio</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,700&family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">
    <!-- Link to external CSS -->
    <link rel="stylesheet" href="style.css">
</head>
<body class="antialiased">

    <canvas id="bgCanvas"></canvas>

    <!-- Navigation -->
    <nav class="fixed top-0 w-full z-50 px-10 py-5 flex justify-between items-center">
        <div class="font-serif text-2xl italic tracking-tighter">
            Fasha<span class="text-pink-400">.</span>
        </div>
        <div class="hidden md:flex gap-10">
            <a href="#home" class="nav-link">Home</a>
            <a href="#about" class="nav-link">About</a>
            <a href="#experience" class="nav-link">Journey</a>
            <a href="#contact" class="nav-link">Connect</a>
        </div>
    </nav>

    <!-- 1️⃣ HERO SECTION -->
    <section id="home" class="min-h-screen flex flex-col md:flex-row justify-center items-center px-10 gap-16 pt-20">
        <div class="md:w-1/2 text-center md:text-left">
            <p class="text-xs font-bold tracking-[0.4em] text-pink-500 mb-6 uppercase">Student & Creator</p>
            <h1 class="font-serif text-5xl md:text-7xl hero-title mb-8">
                Hello! <span class="italic text-yellow-500">Fasha's</span> here.<br>
                <span class="gradient-text">let's get to know me</span>
            </h1>
            <p class="text-gray-500 mb-10 max-w-lg leading-relaxed">
                An enthusiastic high school student based in Magetan, blending leadership roles in OSIS with a creative passion for graphic design and marketing.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
                <a href="#about" class="px-8 py-4 bg-pink-500 text-white rounded-full font-bold text-xs uppercase tracking-widest hover:bg-yellow-400 transition-colors shadow-lg shadow-pink-200">Discover More</a>
                <a href="#contact" class="px-8 py-4 border border-pink-200 rounded-full font-bold text-xs uppercase tracking-widest hover:border-yellow-400 text-pink-500 transition-colors bg-white">Say Hi!</a>
            </div>
        </div>

        <div class="md:w-1/2 flex justify-center">
            <div class="profile-container">
                <div class="profile-frame"></div>
                <div class="profile-img-wrapper">
                    <img src="https://lh3.googleusercontent.com/d/1Dcvq3XtnsYYdfe02exaEi2hwxoE13Es1" alt="Fasha Kharisma Putri" class="w-full h-full object-cover">
                </div>
                <div class="absolute -bottom-4 -right-4 bg-white p-4 rounded-2xl shadow-xl z-30 flex items-center gap-3 animate-bounce-slow">
                    <div class="w-8 h-8 bg-yellow-100 rounded-full flex items-center justify-center text-yellow-600 text-xl">✨</div>
                    <p class="text-[10px] font-bold uppercase tracking-tighter">Creative Mind</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 2️⃣ ABOUT SECTION -->
    <section id="about" class="py-32 px-10">
        <div class="max-w-6xl mx-auto">
            <div class="grid md:grid-cols-2 gap-20 items-center">
                <div class="order-2 md:order-1">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="card-elegant p-8 bg-white border-pink-100">
                            <h3 class="font-serif text-3xl italic mb-2 text-pink-400">01.</h3>
                            <p class="font-bold text-sm mb-1">Education</p>
                            <p class="text-xs text-gray-400">SMAN 1 Magetan</p>
                        </div>
                        <div class="card-elegant p-8 mt-8 bg-white border-yellow-100">
                            <h3 class="font-serif text-3xl italic mb-2 text-yellow-400">02.</h3>
                            <p class="font-bold text-sm mb-1">Born</p>
                            <p class="text-xs text-gray-400">Feb 11, 2008</p>
                        </div>
                    </div>
                </div>
                <div class="order-1 md:order-2">
                    <h2 class="font-serif text-4xl md:text-5xl mb-8 italic">About <span class="text-pink-400">Me.</span></h2>
                    <p class="text-gray-500 leading-relaxed mb-8">
                        I am a student who seeks balance between organization and art. As an active member of OSIS, I have learned the value of communication and teamwork, while my freelance design work allows me to express my creative side.
                    </p>
                    <div class="flex flex-wrap gap-3">
                        <span class="skill-tag">Graphic Design</span>
                        <span class="skill-tag">OSIS SIE 5</span>
                        <span class="skill-tag">Digital Marketing</span>
                        <span class="skill-tag">Cooking</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3️⃣ EXPERIENCE SECTION -->
    <section id="experience" class="py-32 px-10 bg-white border-y border-pink-50">
        <div class="max-w-4xl mx-auto">
            <h2 class="font-serif text-4xl text-center mb-20 italic">The <span class="text-yellow-500">Path</span> I've Taken</h2>
            
            <div class="space-y-16">
                <div class="flex gap-12">
                    <div class="w-1/4 hidden md:block text-right">
                        <span class="text-xs font-black text-pink-400 tracking-[0.3em]">ORGANIZATION</span>
                    </div>
                    <div class="w-full md:w-3/4 border-l border-pink-100 pl-8 relative timeline-item">
                        <h4 class="text-xl font-bold mb-2">Head of SIE 5 OSIS</h4>
                        <p class="text-xs font-bold text-gray-400 mb-4 tracking-widest uppercase">Entrepreneurship Division</p>
                        <p class="text-gray-500 text-sm italic">Leading initiatives that teach students the basics of creative business and organizing school-wide events.</p>
                    </div>
                </div>

                <div class="flex gap-12">
                    <div class="w-1/4 hidden md:block text-right">
                        <span class="text-xs font-black text-yellow-500 tracking-[0.3em]">PROFESSIONAL</span>
                    </div>
                    <div class="w-full md:w-3/4 border-l border-yellow-100 pl-8 relative timeline-item item-yellow">
                        <h4 class="text-xl font-bold mb-2">Marketing & Design</h4>
                        <p class="text-xs font-bold text-gray-400 mb-4 tracking-widest uppercase">Freelance Professional</p>
                        <ul class="text-gray-500 text-sm space-y-2 list-disc list-inside">
                            <li>Graphic Designer at Ndalem Prabu Sarangan (2024-2025)</li>
                            <li>Marketing at Mama’s Farm Store (2025-Present)</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4️⃣ CONTACT SECTION -->
    <section id="contact" class="py-32 px-10 text-center">
        <div class="max-w-2xl mx-auto">
            <h2 class="font-serif text-5xl italic mb-6">Let's create <span class="text-pink-400">something</span> together.</h2>
            <p class="text-gray-400 mb-12">Feel free to reach out for collaboration or just to say hi!</p>
            
            <div class="flex justify-center gap-6">
                <a href="https://instagram.com/fashaaas_" target="_blank" class="contact-icon-pink">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                </a>
                <a href="https://wa.me/081235273450" target="_blank" class="contact-icon-yellow">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="py-12 border-t border-pink-50 text-center">
        <p class="text-[10px] font-bold text-gray-300 uppercase tracking-[0.5em]">Curated by Fasha • 2026</p>
    </footer>

    <!-- Link to external JS -->
    <script src="script.js"></script>
</body>
</html>